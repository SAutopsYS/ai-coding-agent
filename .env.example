# Copy to .env and fill in values. Do not commit real secrets.

# openai | anthropic | gemini | mock
AGENT_LLM_PROVIDER=gemini

# Google AI Studio / Gemini API key
AGENT_LLM_API_KEY=YOUR_API_KEY

# Recommended Gemini model
AGENT_LLM_MODEL=gemini-3.6-flash

# Optional OpenAI-compatible / custom gateway base URL
AGENT_LLM_BASE_URL=
